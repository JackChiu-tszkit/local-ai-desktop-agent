# Copy to .env only if you want environment overrides.
# API keys are never read from this file. Store them in Windows Credential Manager
# from the application's Settings window.

AGENT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud inference is opt-in. Leaving this false keeps file contents and screenshots local.
CLOUD_ENABLED=false
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini
CLOUD_ALLOW_SCREENSHOTS=false
CLOUD_ALLOW_FILE_CONTENTS=false
CLOUD_ALLOW_PATHS=false
